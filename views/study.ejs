<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>YslaNotes — <%= module.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="min-h-screen">
  <nav class="bg-gradient-to-r from-pink-500 via-fuchsia-400 to-pink-500 text-white shadow-lg">
    <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="font-display text-xl font-semibold flex items-center gap-2">
        <%- icon('book', 'icon w-6 h-6') %> YslaNotes
      </a>
      <!-- Desktop nav -->
      <div class="hidden sm:flex items-center gap-3">
        <a href="/" class="text-white/80 hover:text-white text-sm flex items-center gap-1">
          <%- icon('arrowLeft', 'icon w-4 h-4') %> Back to dashboard
        </a>
        <a href="/store" data-sound="click" class="btn-glossy btn-glossy-amber px-3 py-2 rounded-full font-semibold flex items-center gap-1.5" title="Rewards Store">
          <%- icon('coin', 'icon w-4 h-4') %> <%= coinBalance %>
        </a>
        <button id="mute-toggle" class="mute-toggle btn-glossy btn-glossy-icon btn-glossy-outline" title="Toggle sound">
          <span id="mute-icon-on"><%- icon('speakerWave', 'icon w-5 h-5') %></span>
          <span id="mute-icon-off" class="hidden"><%- icon('speakerX', 'icon w-5 h-5') %></span>
        </button>
        <form method="POST" action="/logout">
          <button type="submit" data-sound="click" class="text-white/80 hover:text-white text-sm">Logout</button>
        </form>
      </div>

      <!-- Mobile hamburger -->
      <button id="nav-menu-toggle" class="sm:hidden btn-glossy btn-glossy-icon btn-glossy-outline" aria-label="Menu">
        <%- icon('menu', 'icon w-5 h-5') %>
      </button>
    </div>

    <!-- Mobile dropdown -->
    <div id="nav-menu-mobile" class="hidden sm:hidden flex-col gap-2 px-4 pb-4">
      <a href="/" class="text-white/90 text-sm flex items-center justify-center gap-1 py-1">
        <%- icon('arrowLeft', 'icon w-4 h-4') %> Back to dashboard
      </a>
      <a href="/store" data-sound="click" class="btn-glossy btn-glossy-amber px-4 py-2 rounded-full font-semibold flex items-center justify-center gap-1.5">
        <%- icon('coin', 'icon w-4 h-4') %> <%= coinBalance %> Coins — Store
      </a>
      <div class="flex items-center justify-center gap-3 pt-1">
        <button class="mute-toggle btn-glossy btn-glossy-icon btn-glossy-outline" title="Toggle sound">
          <span id="mute-icon-on-mobile"><%- icon('speakerWave', 'icon w-5 h-5') %></span>
          <span id="mute-icon-off-mobile" class="hidden"><%- icon('speakerX', 'icon w-5 h-5') %></span>
        </button>
        <form method="POST" action="/logout">
          <button type="submit" data-sound="click" class="text-white/90 hover:text-white text-sm px-2">Logout</button>
        </form>
      </div>
    </div>
  </nav>

  <main class="max-w-2xl mx-auto px-4 py-8">
    <div class="mb-6 flex justify-between items-start gap-3">
      <div>
        <span class="inline-block text-xs font-semibold text-pink-600 bg-pink-50 px-2 py-1 rounded-full mb-2">
          <%= module.category %>
        </span>
        <h1 class="text-2xl font-bold text-slate-800"><%= module.title %></h1>
        <p class="text-slate-500"><%= module.description %></p>
      </div>
      <div class="shrink-0 flex flex-col items-end gap-1">
        <a href="/modules/<%= module.id %>/edit" class="text-sm font-semibold text-pink-600 hover:underline whitespace-nowrap flex items-center gap-1">
          <%- icon('pencil', 'icon w-4 h-4') %> Edit Questions
        </a>
        <a href="/modules/<%= module.id %>/print" target="_blank" class="text-sm font-semibold text-pink-600 hover:underline whitespace-nowrap flex items-center gap-1">
          <%- icon('printer', 'icon w-4 h-4') %> Print / Export
        </a>
      </div>
    </div>

    <% if (flashcards.length === 0) { %>
      <div class="text-center py-16 bg-white rounded-xl border border-dashed border-pink-200">
        <p class="text-slate-500">This module has no flashcards yet.</p>
      </div>
    <% } else { %>
      <% if (attempts.length > 0) { %>
        <div class="mb-6 bg-white rounded-xl border border-pink-100 p-4">
          <h2 class="text-sm font-semibold text-slate-700 mb-2">Recent Attempts</h2>
          <ul id="attempts-list" class="text-sm text-slate-500 space-y-1">
            <% attempts.forEach(a => { %>
              <li><%= new Date(a.created_at).toLocaleString() %> — <%= a.correct_count %>/<%= a.total_count %> (<%= a.score_pct %>%)</li>
            <% }) %>
          </ul>
        </div>
      <% } else { %>
        <div class="mb-6 bg-white rounded-xl border border-pink-100 p-4">
          <h2 class="text-sm font-semibold text-slate-700 mb-2">Recent Attempts</h2>
          <ul id="attempts-list" class="text-sm text-slate-500 space-y-1">
            <li id="no-attempts-msg">No attempts yet — finish the quiz below to record your first score.</li>
          </ul>
        </div>
      <% } %>

      <div id="quiz-session">
        <!-- Exam mode -->
        <div id="exam-mode-bar" class="flex items-center justify-between gap-3 mb-4 bg-white border border-pink-100 rounded-lg px-4 py-3">
          <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            <input type="checkbox" id="exam-mode-toggle" />
            <%- icon('clock', 'icon w-4 h-4 text-pink-500') %> Exam Mode
          </label>
          <div id="exam-mode-controls" class="hidden items-center gap-2">
            <select id="exam-duration" class="border border-slate-300 rounded-lg px-2 py-1 text-sm">
              <option value="5">5 min</option>
              <option value="10">10 min</option>
              <option value="15" selected>15 min</option>
              <option value="30">30 min</option>
              <option value="45">45 min</option>
              <option value="60">60 min</option>
            </select>
            <button id="exam-start-btn" type="button" data-sound="click" class="btn-glossy btn-glossy-pink px-3 py-1 rounded-full text-sm font-semibold">
              Start Timer
            </button>
          </div>
          <div id="exam-timer" class="hidden text-lg font-bold text-pink-600"><%- icon('clock', 'icon w-5 h-5 inline align-text-bottom') %> 15:00</div>
        </div>

        <!-- Progress -->
        <div class="mb-4">
          <div class="flex justify-between items-center mb-1 text-sm text-slate-500">
            <span id="card-counter">Card 1 of <%= flashcards.length %></span>
            <div class="flex gap-2">
              <span class="score-badge correct"><%- icon('checkCircle', 'icon w-4 h-4') %> <span id="got-it-count">0</span></span>
              <span class="score-badge review"><%- icon('refresh', 'icon w-4 h-4') %> <span id="review-count">0</span></span>
            </div>
          </div>
          <div class="progress-track">
            <div id="progress-fill" class="progress-fill" style="width: 0%"></div>
          </div>
        </div>

        <!-- Flashcard (flashcard / situational types) -->
        <div id="flashcard-container">
          <div id="flashcard" class="flip-card mb-6">
            <div class="flip-card-inner">
              <div class="flip-card-front">
                <p id="card-front-text"></p>
              </div>
              <div class="flip-card-back">
                <div class="max-h-full overflow-y-auto">
                  <p id="card-back-text"></p>
                  <p id="card-back-rationale" class="hidden text-sm font-normal opacity-90 mt-3"></p>
                </div>
              </div>
            </div>
          </div>
          <p class="text-center text-slate-400 text-sm mb-6">Click the card (or press space) to flip it</p>
        </div>

        <!-- Multiple choice -->
        <div id="mc-container" class="hidden mb-6">
          <div class="bg-white rounded-xl border border-pink-100 shadow-sm p-6">
            <p id="mc-question" class="text-lg font-semibold text-slate-800 mb-4"></p>
            <div id="mc-options" class="flex flex-col gap-3"></div>
            <p id="mc-feedback" class="mt-4 font-semibold hidden"></p>
            <p id="mc-rationale" class="mt-2 text-sm text-slate-500 hidden"></p>
          </div>
        </div>

        <!-- Navigation -->
        <div class="flex justify-between items-center mb-6">
          <button id="prev-btn" data-sound="click" class="btn-glossy btn-glossy-outline px-4 py-2 rounded-full flex items-center gap-1">
            <%- icon('arrowLeft', 'icon w-4 h-4') %> Previous
          </button>
          <button id="next-btn" data-sound="click" class="btn-glossy btn-glossy-outline px-4 py-2 rounded-full flex items-center gap-1">
            Next <%- icon('arrowRight', 'icon w-4 h-4') %>
          </button>
        </div>

        <!-- Self-assessment -->
        <div id="self-assess" class="flex justify-center gap-4 mb-4">
          <button id="review-btn" class="btn-glossy btn-glossy-pink px-5 py-2 rounded-full font-semibold flex items-center gap-1.5">
            <%- icon('xCircle', 'icon w-4 h-4') %> Needs review
          </button>
          <button id="got-it-btn" class="btn-glossy btn-glossy-emerald px-5 py-2 rounded-full font-semibold flex items-center gap-1.5">
            <%- icon('checkCircle', 'icon w-4 h-4') %> Got it right
          </button>
        </div>

        <div class="text-center">
          <button id="restart-btn" class="text-slate-400 text-sm hover:text-slate-600 hover:underline flex items-center gap-1 mx-auto">
            <%- icon('refresh', 'icon w-3.5 h-3.5') %> Restart session
          </button>
        </div>
      </div>

      <!-- Completion screen -->
      <div id="completion-screen" class="hidden text-center bg-white rounded-xl border border-pink-100 shadow-sm p-8">
        <h2 class="text-2xl font-bold text-slate-800 mb-1 flex items-center justify-center gap-2">
          <%- icon('trophy', 'icon w-7 h-7 text-pink-500') %> Quiz Complete!
        </h2>
        <p class="text-slate-500 mb-6">Here's how you did on <strong><%= module.title %></strong>.</p>

        <div class="flex justify-center gap-8 mb-8">
          <div>
            <p class="text-3xl font-bold text-emerald-600" id="final-correct">0</p>
            <p class="text-sm text-slate-500">Correct</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-pink-500" id="final-review">0</p>
            <p class="text-sm text-slate-500">Needs review</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-slate-700" id="final-score-pct">0%</p>
            <p class="text-sm text-slate-500">Score</p>
          </div>
        </div>

        <div id="coins-earned-box" class="hidden inline-flex items-center gap-2 bg-amber-50 text-amber-700 font-bold px-4 py-2 rounded-full mb-6">
          <%- icon('coin', 'icon w-5 h-5') %> +<span id="coins-earned-amount">0</span> coins earned!
        </div>

        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <button id="restart-from-complete-btn" data-sound="click" class="btn-glossy btn-glossy-outline px-5 py-2 rounded-full flex items-center justify-center gap-1.5">
            <%- icon('refresh', 'icon w-4 h-4') %> Restart Quiz
          </button>
          <button id="review-missed-btn" data-sound="click" class="btn-glossy btn-glossy-amber hidden px-5 py-2 rounded-full font-semibold">
            Review Missed (<span id="missed-count">0</span>)
          </button>
          <% if (canRegenerate) { %>
            <form method="POST" action="/modules/<%= module.id %>/regenerate">
              <button type="submit" data-sound="click" data-confirm="Generate a brand-new set of questions from the same source material? This replaces the current questions."
                class="btn-glossy btn-glossy-pink w-full px-5 py-2 rounded-full font-semibold flex items-center justify-center gap-1.5">
                <%- icon('sparkles', 'icon w-4 h-4') %> Regenerate Quiz
              </button>
            </form>
          <% } %>
          <a href="/" class="btn-glossy btn-glossy-outline px-5 py-2 rounded-full flex items-center justify-center">
            Back to Dashboard
          </a>
        </div>
      </div>
    <% } %>
  </main>

  <% if (canRegenerate) { %>
    <!-- Regenerate loading overlay (Gemini can take up to ~2 minutes) -->
    <div id="regenerate-overlay" class="hidden fixed inset-0 bg-white/90 backdrop-blur-sm items-center justify-center z-50">
      <div class="text-center px-6">
        <div class="loading-spinner mx-auto mb-5"></div>
        <p id="regenerate-message" class="font-display text-lg font-semibold text-pink-600 mb-1">Writing a brand-new set of questions...</p>
        <p class="text-slate-400 text-sm">Please don't close this tab — this can take up to a couple of minutes.</p>
      </div>
    </div>
  <% } %>

  <!-- Ariana Grande music player -->
  <div class="music-player">
    <button id="music-player-toggle" class="btn-glossy btn-glossy-pink btn-glossy-icon music-fab" title="Music player">
      <%- icon('musicNote', 'icon w-5 h-5') %>
    </button>
    <div id="music-panel" class="music-panel hidden">
      <p class="music-panel-title">Ariana Grande</p>
      <p id="music-track-title" class="music-track-title">&mdash;</p>
      <div class="music-controls">
        <button id="music-prev" title="Previous"><%- icon('skipBack', 'icon w-4 h-4') %></button>
        <button id="music-playpause" title="Play / Pause">
          <span id="music-play-icon"><%- icon('play', 'icon w-5 h-5') %></span>
          <span id="music-pause-icon" class="hidden"><%- icon('pause', 'icon w-5 h-5') %></span>
        </button>
        <button id="music-next" title="Next"><%- icon('skipForward', 'icon w-4 h-4') %></button>
      </div>
      <ul id="music-track-list"></ul>
    </div>
    <div id="spotify-embed-container" style="position:absolute; width:1px; height:1px; overflow:hidden; opacity:0; pointer-events:none;"></div>
  </div>

  <script>
    const flashcards = <%- JSON.stringify(flashcards) %>;
    const moduleId = <%= module.id %>;
  </script>
  <script src="/js/sounds.js"></script>
  <script src="/js/nav-menu.js"></script>
  <script src="/js/mascot.js"></script>
  <script src="/js/hearts.js"></script>
  <script src="/js/confirm-modal.js"></script>
  <script src="/js/confetti.js"></script>
  <script src="/js/quiz.js"></script>
  <script src="/js/spotify-player.js"></script>
  <% if (canRegenerate) { %>
  <script>
    (function () {
      const messages = [
        'Writing a brand-new set of questions...',
        'Shuffling in fresh angles on the material...',
        'Double-checking every answer...',
        'Almost there...'
      ];
      const form = document.querySelector('form[action$="/regenerate"]');
      const overlay = document.getElementById('regenerate-overlay');
      const messageEl = document.getElementById('regenerate-message');
      if (!form || !overlay) return;

      form.addEventListener('submit', (e) => {
        const submitter = e.submitter;
        // if this submit still needs the confirm-modal's OK click, don't show the overlay yet
        if (submitter && submitter.dataset.confirm && submitter.dataset.confirmed !== 'true') return;

        let i = 0;
        messageEl.textContent = messages[0];
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        setInterval(() => {
          i = (i + 1) % messages.length;
          messageEl.style.opacity = 0;
          setTimeout(() => {
            messageEl.textContent = messages[i];
            messageEl.style.opacity = 1;
          }, 200);
        }, 2400);
      });
    })();
  </script>
  <% } %>
</body>
</html>
