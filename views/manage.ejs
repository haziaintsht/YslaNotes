<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>YslaNotes — Edit <%= module.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="min-h-screen">
  <nav class="bg-gradient-to-r from-pink-500 via-fuchsia-400 to-pink-500 text-white shadow-lg">
    <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="font-display text-xl font-semibold flex items-center gap-2">
        <%- icon('book', 'icon w-6 h-6') %> YslaNotes
      </a>
      <!-- Desktop nav -->
      <div class="hidden sm:flex items-center gap-3">
        <a href="/study/<%= module.id %>" class="text-white/80 hover:text-white text-sm flex items-center gap-1">
          <%- icon('arrowLeft', 'icon w-4 h-4') %> Back to study
        </a>
        <a href="/store" data-sound="click" class="btn-glossy btn-glossy-amber px-3 py-2 rounded-full font-semibold flex items-center gap-1.5" title="Rewards Store">
          <%- icon('coin', 'icon w-4 h-4') %> <%= coinBalance %>
        </a>
        <button id="mute-toggle" class="mute-toggle btn-glossy btn-glossy-icon btn-glossy-outline" title="Toggle sound">
          <span id="mute-icon-on"><%- icon('speakerWave', 'icon w-5 h-5') %></span>
          <span id="mute-icon-off" class="hidden"><%- icon('speakerX', 'icon w-5 h-5') %></span>
        </button>
        <form method="POST" action="/logout">
          <button type="submit" data-sound="click" class="text-white/80 hover:text-white text-sm">Logout</button>
        </form>
      </div>

      <!-- Mobile hamburger -->
      <button id="nav-menu-toggle" class="sm:hidden btn-glossy btn-glossy-icon btn-glossy-outline" aria-label="Menu">
        <%- icon('menu', 'icon w-5 h-5') %>
      </button>
    </div>

    <!-- Mobile dropdown -->
    <div id="nav-menu-mobile" class="hidden sm:hidden flex-col gap-2 px-4 pb-4">
      <a href="/study/<%= module.id %>" class="text-white/90 text-sm flex items-center justify-center gap-1 py-1">
        <%- icon('arrowLeft', 'icon w-4 h-4') %> Back to study
      </a>
      <a href="/store" data-sound="click" class="btn-glossy btn-glossy-amber px-4 py-2 rounded-full font-semibold flex items-center justify-center gap-1.5">
        <%- icon('coin', 'icon w-4 h-4') %> <%= coinBalance %> Coins — Store
      </a>
      <div class="flex items-center justify-center gap-3 pt-1">
        <button class="mute-toggle btn-glossy btn-glossy-icon btn-glossy-outline" title="Toggle sound">
          <span id="mute-icon-on-mobile"><%- icon('speakerWave', 'icon w-5 h-5') %></span>
          <span id="mute-icon-off-mobile" class="hidden"><%- icon('speakerX', 'icon w-5 h-5') %></span>
        </button>
        <form method="POST" action="/logout">
          <button type="submit" data-sound="click" class="text-white/90 hover:text-white text-sm px-2">Logout</button>
        </form>
      </div>
    </div>
  </nav>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-slate-800 mb-1 flex items-center gap-2">
      <%- icon('pencil', 'icon w-6 h-6 text-pink-500') %> Edit Questions
    </h1>
    <p class="text-slate-500 mb-6"><strong><%= module.title %></strong> · <%= flashcards.length %> question<%= flashcards.length === 1 ? '' : 's' %></p>

    <% if (error) { %>
      <div class="bg-pink-50 border border-pink-200 text-pink-700 rounded-lg px-4 py-3 mb-6">
        <%= error %>
      </div>
    <% } %>

    <div class="flex flex-col gap-4 mb-8">
      <% flashcards.forEach(card => { %>
        <form method="POST" action="/flashcards/<%= card.id %>/update" class="qa-row">
          <input type="hidden" name="module_id" value="<%= module.id %>" />

          <div class="flex justify-between items-center mb-3">
            <select name="question_type" class="border border-slate-300 rounded-lg px-2 py-1 text-sm">
              <option value="flashcard" <%= card.question_type === 'flashcard' ? 'selected' : '' %>>Flashcard</option>
              <option value="multiple_choice" <%= card.question_type === 'multiple_choice' ? 'selected' : '' %>>Multiple choice</option>
              <option value="true_false" <%= card.question_type === 'true_false' ? 'selected' : '' %>>True / False</option>
              <option value="situational" <%= card.question_type === 'situational' ? 'selected' : '' %>>Situational</option>
            </select>
            <button type="submit" formaction="/flashcards/<%= card.id %>/delete" data-confirm="Delete this question?"
              class="text-pink-500 text-sm hover:underline flex items-center gap-1">
              <%- icon('trash', 'icon w-4 h-4') %> Delete
            </button>
          </div>

          <label class="block text-xs font-semibold text-slate-500 mb-1">Question</label>
          <textarea name="question" required rows="2"
            class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"><%= card.question %></textarea>

          <label class="block text-xs font-semibold text-slate-500 mb-1">Answer <% if (card.question_type === 'true_false') { %>(exactly "True" or "False")<% } %></label>
          <textarea name="answer" required rows="2"
            class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"><%= card.answer %></textarea>

          <label class="block text-xs font-semibold text-slate-500 mb-1">Rationale (optional — explains why the answer is correct)</label>
          <textarea name="rationale" rows="2"
            class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"><%= card.rationale || '' %></textarea>

          <label class="block text-xs font-semibold text-slate-500 mb-1">Options (multiple choice only — one per line, must include the exact answer text above; ignored for True/False)</label>
          <textarea name="options" rows="4" placeholder="Option A&#10;Option B&#10;Option C&#10;Option D"
            class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"><%= Array.isArray(card.options) ? card.options.join('\n') : '' %></textarea>

          <button type="submit" data-sound="click" class="btn-glossy btn-glossy-pink w-full py-2 rounded-full font-semibold">
            Save
          </button>
        </form>
      <% }) %>
    </div>

    <h2 class="text-lg font-bold text-slate-800 mb-3 flex items-center gap-2">
      <%- icon('plusCircle', 'icon w-5 h-5 text-pink-500') %> Add a Question
    </h2>
    <form method="POST" action="/modules/<%= module.id %>/flashcards/add" class="qa-row">
      <label class="block text-xs font-semibold text-slate-500 mb-1">Question type</label>
      <select name="question_type" class="border border-slate-300 rounded-lg px-2 py-1 text-sm mb-3">
        <option value="flashcard">Flashcard</option>
        <option value="multiple_choice">Multiple choice</option>
        <option value="true_false">True / False</option>
        <option value="situational">Situational</option>
      </select>

      <label class="block text-xs font-semibold text-slate-500 mb-1">Question</label>
      <textarea name="question" required rows="2"
        class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"></textarea>

      <label class="block text-xs font-semibold text-slate-500 mb-1">Answer (for True/False, use exactly "True" or "False")</label>
      <textarea name="answer" required rows="2"
        class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"></textarea>

      <label class="block text-xs font-semibold text-slate-500 mb-1">Rationale (optional — explains why the answer is correct)</label>
      <textarea name="rationale" rows="2"
        class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"></textarea>

      <label class="block text-xs font-semibold text-slate-500 mb-1">Options (multiple choice only — one per line; ignored for True/False)</label>
      <textarea name="options" rows="4" placeholder="Option A&#10;Option B&#10;Option C&#10;Option D"
        class="w-full border border-slate-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-pink-400"></textarea>

      <button type="submit" data-sound="click" class="btn-glossy btn-glossy-fuchsia w-full py-2 rounded-full font-semibold flex items-center justify-center gap-2">
        <%- icon('plusCircle', 'icon w-4 h-4') %> Add Question
      </button>
    </form>
  </main>

  <!-- Ariana Grande music player -->
  <div class="music-player">
    <button id="music-player-toggle" class="btn-glossy btn-glossy-pink btn-glossy-icon music-fab" title="Music player">
      <%- icon('musicNote', 'icon w-5 h-5') %>
    </button>
    <div id="music-panel" class="music-panel hidden">
      <p class="music-panel-title">Ariana Grande</p>
      <p id="music-track-title" class="music-track-title">&mdash;</p>
      <div class="music-controls">
        <button id="music-prev" title="Previous"><%- icon('skipBack', 'icon w-4 h-4') %></button>
        <button id="music-playpause" title="Play / Pause">
          <span id="music-play-icon"><%- icon('play', 'icon w-5 h-5') %></span>
          <span id="music-pause-icon" class="hidden"><%- icon('pause', 'icon w-5 h-5') %></span>
        </button>
        <button id="music-next" title="Next"><%- icon('skipForward', 'icon w-4 h-4') %></button>
      </div>
      <ul id="music-track-list"></ul>
    </div>
    <div id="spotify-embed-container" style="position:absolute; width:1px; height:1px; overflow:hidden; opacity:0; pointer-events:none;"></div>
  </div>

  <script src="/js/sounds.js"></script>
  <script src="/js/nav-menu.js"></script>
  <script src="/js/mascot.js"></script>
  <script src="/js/hearts.js"></script>
  <script src="/js/confirm-modal.js"></script>
  <script src="/js/spotify-player.js"></script>
</body>
</html>
